# Domo — example environment file.
# Copy to `.env` and fill in. `py wizard.py` writes most of these for you.
# NEVER commit a real .env. Values below are placeholders only.

# ─────────────────────── Claude authentication ─────────────────────────
# Domo authenticates through Claude Code. Use EITHER:
#   - a logged-in subscription:  run `claude login`  (no variable needed here), or
#   - an API key:                set ANTHROPIC_API_KEY  (bills as API usage).
# When both are present, the SDK uses ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────── Core (required) ───────────────────────────

# Your own Discord user ID. Domo only responds to this user. (Discord →
# Settings → Advanced → Developer Mode, then right-click yourself → Copy ID.)
OPERATOR_USER_ID=000000000000000000

# ─────────────────────── Per-agent Discord bots ────────────────────────
# Each council agent is its own Discord bot application with its own token
# and channel. At minimum `main` must be configured.
#
#   *_DISCORD_TOKEN : the bot token (Developer Portal → your app → Bot → Token)
#   *_CHANNEL_ID    : the text channel that agent owns (DMs + this channel +
#                     threads under it)
#   *_WEBHOOK_URL   : optional, rarely needed with per-agent bots — leave unset

# Operator (main)
MAIN_DISCORD_TOKEN=your-main-bot-token
MAIN_CHANNEL_ID=000000000000000000
# MAIN_WEBHOOK_URL=

# Research specialist
RESEARCH_DISCORD_TOKEN=your-research-bot-token
RESEARCH_CHANNEL_ID=000000000000000000
# RESEARCH_WEBHOOK_URL=

# Comms specialist
COMMS_DISCORD_TOKEN=your-comms-bot-token
COMMS_CHANNEL_ID=000000000000000000
# COMMS_WEBHOOK_URL=

# Legacy single-bot fallback (Phase 1). If MAIN_DISCORD_TOKEN is unset, the
# main agent falls back to DISCORD_TOKEN / OPERATOR_CHANNEL_ID. Prefer the
# per-agent vars above.
# DISCORD_TOKEN=
# OPERATOR_CHANNEL_ID=000000000000000000

# ─────────────────────── Working directory / vault ─────────────────────
# Directory Claude Code runs in (and, by convention, your notes vault). Both
# default to ~/Documents/second-brain[-bot]; override to point elsewhere.
# VAULT_ROOT=C:\Users\you\Documents\second-brain
# BOT_CWD=C:\Users\you\Documents\second-brain-bot
# CLAUDE_MEMORY_DIR=   # override the auto-derived Claude Code memory dir

# ─────────────────────────── Dashboard (optional) ──────────────────────
# Mission Control web UI. Enabled only when BOTH PIN_HASH and SESSION_SECRET
# are set (the wizard sets them). Binds to localhost by default.
# DASHBOARD_PIN_HASH=         # bcrypt hash of your PIN (wizard generates)
# DASHBOARD_SESSION_SECRET=   # cookie-signing secret (wizard generates)
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_SESSION_TTL_HOURS=8

# Channel where unmanaged cron/reminder results post by default.
# INBOX_CHANNEL_ID=000000000000000000

# ─────────────────────── Calendar (optional, iCloud) ───────────────────
# Apple iCloud CalDAV. Calendar tools are skipped unless BOTH the Apple ID
# and an app-specific password are set.
# ICLOUD_APPLE_ID=you@icloud.com
# ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ICLOUD_ALLOWED_CALENDARS=Personal,Work     # comma-separated; default: all
# ICLOUD_READONLY_CALENDARS=Family,Holidays  # subset agents may not modify
# CALENDAR_TOKEN_SECRET=                      # optional HMAC key for opaque ids

# ─────────────────── Voice transcription (optional) ────────────────────
# Groq Whisper API key. Enables transcription of Discord voice-note
# attachments (the multimodal intake path in src/spawner.py).
# GROQ_API_KEY=gsk_...

# ─────────────────────── GPT-5 specialist (optional) ───────────────────
# Path to the local Codex CLI. Auto-detected from PATH / npm if unset; set
# explicitly to override. The specialist tool is skipped when not found.
# CODEX_EXE_PATH=C:\Users\you\AppData\Roaming\npm\codex.cmd

# ─────────────────────────────── Cron ──────────────────────────────────
CRON_TZ=America/New_York
CRON_MIN_INTERVAL_MINUTES=5
CRON_TICK_SECONDS=30
CRON_MAX_CONCURRENT=3
CRON_AUTO_PAUSE=true

# ─────────────────────── Credit governor (optional) ────────────────────
# Tracks Anthropic Agent SDK spend against a monthly ceiling. Observe-only
# until ENFORCE=true. The cycle resets on BILLING_CYCLE_START_DAY (1–28).
BILLING_CYCLE_START_DAY=15
CREDIT_AGENT_SDK_USD=100.0
CREDIT_GOVERNOR_ENFORCE=false

# ──────────────────── ElevenLabs voice notes (optional) ────────────────
# TTS for spoken end-of-run summaries (src/voice/). Restrict the key in the
# ElevenLabs dashboard: TTS-only scope + a per-cycle credit cap. The daily
# character budget below is the app-side runaway ceiling (~150 words/day of
# real use; the ceiling is not a target).
# ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_DAILY_CHAR_BUDGET=2000
